# Local browser: host API
EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
# Expo Go: explicitly set your own development machine's LAN URL for same-Wi-Fi use.
# EXPO_PUBLIC_LAN_API_BASE_URL=http://192.0.2.1:8000
# 192.0.2.1 is a documentation-only placeholder; replace it before enabling.
# Google Places is called by the backend; do not put a Google key in Expo env.
# Google sign-in: OAuth client IDs from Google Cloud Console (they are public).
# Each platform shows the Google button only when its ID is set.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
